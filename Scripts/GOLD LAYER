
-- GOLD LAYER (STAR SCHEMA - ANALYTICS)


USE dwh_project;


-- DIMENSION: CUSTOMERS


DROP VIEW IF EXISTS dim_customers;

CREATE VIEW dim_customers AS
SELECT
    ROW_NUMBER() OVER (ORDER BY customer_id) AS customer_key,   -- surrogate key
    customer_id,
    cst_key AS customer_number,
    first_name,
    last_name,
    gender,
    country,
    bdate,
    cst_create_date
FROM silver_customers;


-- DIMENSION: PRODUCTS


DROP VIEW IF EXISTS dim_products;

CREATE VIEW dim_products AS
SELECT
    ROW_NUMBER() OVER (ORDER BY prd_key) AS product_key,  -- surrogate key
    prd_key AS product_number,
    product_name,
    category_id,
    cost,
    product_line,
    prd_start_dt AS start_date
FROM silver_products
WHERE prd_end_dt IS NULL;   -- only latest records 


-- DIMENSION: CATEGORY


DROP VIEW IF EXISTS dim_category;

CREATE VIEW dim_category AS
SELECT
    id AS category_id,
    cat AS category_name,
    subcat,
    maintenance
FROM silver_category;


-- DIMENSION: DATE


DROP VIEW IF EXISTS dim_date;

CREATE VIEW dim_date AS
SELECT DISTINCT
    order_date AS date_key,
    YEAR(order_date) AS year,
    MONTH(order_date) AS month,
    DAY(order_date) AS day
FROM silver_sales;


-- FACT TABLE: SALES


DROP VIEW IF EXISTS fact_sales;

CREATE VIEW fact_sales AS
SELECT
    s.sls_ord_num AS order_number,

    -- Foreign Keys
    d.product_key,
    c.customer_key,

    s.order_date,
    s.ship_date,
    s.due_date,

    -- Measures
    s.sls_quantity AS quantity,
    s.price,
    s.sales

FROM silver_sales s

LEFT JOIN dim_products d
    ON s.sls_prd_key = d.product_number

LEFT JOIN dim_customers c
    ON s.sls_cust_id = c.customer_id;
